<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body style="margin:0">
    <canvas id="myCanvas"width="1000" height="1000" style="border: 1px solid blue"></canvas>
    
    <script>
        var canvas=document.getElementById("myCanvas");
        var ctx=canvas.getContext("2d");


        ctx.font="16px Arial";
        ctx.fillStyle="#0095DD";
        ctx.fillText("Оноо:"+0, 20, 20);

        ctx.font="16px Arial";
        ctx.fillStyle="#0095DD";
        ctx.fillText("Амь:"+3, 420, 20);
        ctx.beginpath();
        ctx.rect(30,30,60,20);
        ctx.fillStyle="#0095DD";
        ctx.fill();
        ctx.closePath(); 

        ctx.beginPath();
        ctx.rect(110,30,60,20);
        ctx.fillStyle="#0095DD";
        ctx.fill();
        ctx.closePath();

        ctx.beginPath();
        ctx.rect(190,30,60,20);
        ctx.fillStyle="#0095DD";
        ctx.fill();
        ctx.closePath();
        
        ctx.beginPath();
        ctx.rect(110,70,60,20);
        ctx.fillStyle="#0095DD";
        ctx.fill();
        ctx.closePath();

        ctx.beginPath();
        ctx.rect(190,110,60,20);
        ctx.fillStyle="#0095DD";
        ctx.fill();
        ctx.closePath();

        ctx.beginPath();
        ctx.rect(200,400,80,10);
        ctx.fillStyle="yale";
        ctx.fill();
        ctx.closePath();

        ctx.beginPath();
        ctx.rect(240,390,10,0,2*3.14, false);
        ctx.fillStyle="yale";
        ctx.fill();
        ctx.closePath();




    </script>
    
</body>
</html>